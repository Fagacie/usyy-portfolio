{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.mjs",
    "playwright.config.ts",
    "tests/**/*"
  ],
  "exclude": ["dist", "node_modules"]
}
