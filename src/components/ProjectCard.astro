---
import { ArrowUpRight, Code2, ExternalLink, Star } from '@lucide/astro';
import type { Project } from '../data/projects';
import { githubMetadata } from '../data/github-metadata';

type Props = { project: Project; compact?: boolean };
const { project, compact = false } = Astro.props;
const meta = githubMetadata[project.slug];
---
<article class:list={['project-card', compact && 'project-card-compact']} data-project-card data-category={project.category} data-search={`${project.title} ${project.description} ${project.stack.join(' ')} ${project.categoryLabel}`.toLowerCase()}>
  <div class={`project-art project-art--${project.visual}`} aria-hidden="true">
    <div class="art-window-bar"><span></span><span></span><span></span><i>{project.categoryLabel}</i></div>
    <div class="art-content">
      <div class="art-side-rail"><span></span><span></span><span></span><span></span></div>
      <div class="art-main-panel">
        <div class="art-panel-heading"><span class="art-panel-mark"></span><span class="art-line art-line-long"></span></div>
        <div class="art-metric-row"><span></span><span></span><span></span></div>
        <div class="art-panel-grid"><span></span><span></span><span></span><span></span></div>
      </div>
    </div>
    <span class="art-category">{project.category === 'iot' ? 'Connected systems' : project.category === 'research' ? 'Applied research' : 'Software project'}</span>
  </div>

  <div class="project-card-body">
    <div class="project-card-meta"><span class="category-label">{project.categoryLabel}</span><span class="project-status"><span class="status-dot"></span>{project.status}</span></div>
    <h3><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
    <p class="project-description">{project.description}</p>
    <div class="tag-list" aria-label="Technology stack">
      {project.stack.slice(0, compact ? 3 : 4).map((technology) => <span class="tag">{technology}</span>)}
    </div>
    <div class="project-card-footer">
      <a class="text-link" href={`/projects/${project.slug}`}>Read case study <ArrowUpRight size={15} aria-hidden="true" /></a>
      <div class="project-source-meta">
        {project.repoUrl && meta && project.repoLabel !== 'Browse GitHub profile' && <span title="Repository stars"><Star size={13} aria-hidden="true" /> {meta.stars}</span>}
        {project.repoUrl && <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.repoLabel || 'Open source'} for ${project.title}`} title={project.repoLabel || 'Open source'}><Code2 size={16} aria-hidden="true" /></a>}
        {project.demoUrl && <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title} demo`} title="Open live demo"><ExternalLink size={15} aria-hidden="true" /></a>}
      </div>
    </div>
  </div>
</article>
