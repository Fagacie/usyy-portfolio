---
import { ArrowUpRight, CodeXml, ExternalLink } from '@lucide/astro';
import type { Project } from '../data/projects';

type Props = { project: Project; compact?: boolean };
const { project, compact = false } = Astro.props;
const categoryName = project.category === 'iot' ? 'Connected systems' : project.category === 'research' ? 'Applied research' : 'Software project';
const projectOrder = ['psm-e-learning', 'iot-monitoring', 'pku-management', 'weatherhub', 'masakjerr', 'elite-soccer'];
const projectIndex = projectOrder.indexOf(project.slug) + 1;
---
<article class:list={['project-card', compact && 'project-card-compact']} data-project-card data-category={project.category} data-search={`${project.title} ${project.description} ${project.stack.join(' ')} ${project.categoryLabel}`.toLowerCase()}>
  <div class="project-cover" aria-label={`${project.title} project summary`}>
    <span class="project-cover-index">{String(projectIndex).padStart(2, '0')}</span>
    <div class="project-cover-copy">
      <span class="project-cover-type">{categoryName}</span>
      <strong>{project.shortTitle}</strong>
    </div>
    <span class="project-cover-status"><span class="status-dot" aria-hidden="true"></span>{project.status}</span>
  </div>

  <div class="project-card-body">
    <div class="project-card-meta"><span class="category-label">{project.categoryLabel}</span><span class="project-status"><span class="status-dot" aria-hidden="true"></span>{project.status}</span></div>
    <h3><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
    <p class="project-description">{project.description}</p>
    <div class="tag-list" aria-label="Technology stack">
      {project.stack.slice(0, compact ? 3 : 4).map((technology) => <span class="tag">{technology}</span>)}
    </div>
    <div class="project-card-footer">
      <a class="text-link" href={`/projects/${project.slug}`}>Read case study <ArrowUpRight size={15} aria-hidden="true" /></a>
      <div class="project-source-meta">
        {project.repoUrl && <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.repoLabel || 'Open source'} for ${project.title}`} title={project.repoLabel || 'Open source'}><CodeXml size={16} aria-hidden="true" /></a>}
        {project.demoUrl && <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title} demo`} title="Open live demo"><ExternalLink size={15} aria-hidden="true" /></a>}
      </div>
    </div>
  </div>
</article>
