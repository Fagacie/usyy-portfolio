---
import { ArrowUpRight, Award, BookOpen, Cpu, FileBadge, GraduationCap, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { recognition } from '../data/recognition';
---
<BaseLayout title="Awards & recognition | Usman Abbas Adamu" description="Academic recognition, programme certificates, and community leadership credentials." active="awards">
  <section class="page-shell">
    <div class="container">
      <div class="page-hero">
        <p class="eyebrow">Awards & recognition</p>
        <h1>Progress, participation <span style="color:var(--accent)">and service.</span></h1>
        <p class="lede">A record of academic recognition, technical programmes, and community responsibilities. Credential links open the available source document; titles are kept conservative where the exact award classification needs confirmation.</p>
      </div>
      <div class="recognition-grid">
        {recognition.map((item) => (
          <article class="recognition-card">
            <div class="recognition-icon">
              {item.visual === 'award' ? <Award size={20} aria-hidden="true" /> : item.visual === 'academic' ? <GraduationCap size={20} aria-hidden="true" /> : item.visual === 'marine' ? <Cpu size={20} aria-hidden="true" /> : item.visual === 'technology' ? <BookOpen size={20} aria-hidden="true" /> : <Users size={20} aria-hidden="true" />}
            </div>
            <p class="recognition-kind">{item.kind}</p>
            <h3>{item.title}</h3>
            <p>{item.subtitle}</p>
            <a class="text-link" href={item.href || '/contact'} target="_blank" rel="noopener noreferrer">Open credential <ArrowUpRight size={15} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
      <p class="form-hint" style="margin-top:24px">Some academic labels may be updated after checking each original certificate against the recorded semester or award wording.</p>
      <section class="section">
        <div class="cta-panel"><div><p class="eyebrow">Need verification?</p><h2>Ask about a credential.</h2><p>Use the contact page if you need context about a programme, project, or role shown here.</p></div><div class="cta-actions"><a class="button button-primary" href="/contact">Contact me <ArrowUpRight size={15} aria-hidden="true" /></a></div></div>
      </section>
    </div>
  </section>
</BaseLayout>
