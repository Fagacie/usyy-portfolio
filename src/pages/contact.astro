---
import { ArrowUpRight, CodeXml, Mail, MapPinned, Network, Send } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const formEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '';
---
<BaseLayout title="Contact | Usman Abbas Adamu" description="Get in touch with Usman Abbas Adamu about software engineering, projects, internships, and collaboration." active="contact">
  <section class="page-shell">
    <div class="container">
      <div class="page-hero">
        <p class="eyebrow">Contact</p>
        <h1>Let’s talk about <span style="color:var(--accent)">what needs building.</span></h1>
        <p class="lede">For software engineering opportunities, project discussions, or technical collaboration, send a message or reach out through a professional channel.</p>
      </div>
      <div class="contact-grid">
        <div class="contact-copy">
          <h2>Start with a clear problem.</h2>
          <p class="section-description">A little context about the project, goal, or opportunity helps me respond with a useful next step.</p>
          <div class="contact-methods">
            <a class="contact-method" href="mailto:fagacie@gmail.com"><span class="contact-method-icon"><Mail size={18} aria-hidden="true" /></span><span><strong>Email</strong><span>fagacie@gmail.com</span></span></a>
            <a class="contact-method" href="https://www.linkedin.com/in/fagacie" target="_blank" rel="noopener noreferrer"><span class="contact-method-icon"><Network size={18} aria-hidden="true" /></span><span><strong>LinkedIn</strong><span>Professional profile</span></span><ArrowUpRight size={15} aria-hidden="true" /></a>
            <a class="contact-method" href="https://github.com/Fagacie" target="_blank" rel="noopener noreferrer"><span class="contact-method-icon"><CodeXml size={18} aria-hidden="true" /></span><span><strong>GitHub</strong><span>Projects and source links</span></span><ArrowUpRight size={15} aria-hidden="true" /></a>
            <div class="contact-method"><span class="contact-method-icon"><MapPinned size={18} aria-hidden="true" /></span><span><strong>Location</strong><span>Malaysia · Universiti Malaysia Terengganu</span></span></div>
          </div>
        </div>
        <form class="contact-form" data-contact-form data-form-mode={formEndpoint ? 'service' : 'mailto'} action={formEndpoint || 'mailto:fagacie@gmail.com'} method={formEndpoint ? 'POST' : 'GET'}>
          {formEndpoint && <input type="hidden" name="_subject" value="Portfolio contact request" />}
          <div class="form-grid">
            <div class="form-field"><label for="contact-name">Your name</label><input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Name" required /></div>
            <div class="form-field"><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></div>
          </div>
          <div class="form-field"><label for="contact-subject">Subject</label><input id="contact-subject" name="subject" type="text" placeholder="What would you like to discuss?" required /></div>
          <div class="form-field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" placeholder="Add a little context about the project or opportunity..." required></textarea></div>
          <p class="form-hint">{formEndpoint ? 'This form is connected to the configured submission service.' : 'Without a configured form endpoint, this opens your email application. You must send the message from there.'}</p>
          <button class="button button-primary" type="submit"><Send size={16} aria-hidden="true" /> {formEndpoint ? 'Send message' : 'Prepare email'}</button>
          <p class="form-status" data-form-status aria-live="polite"></p>
          {!formEndpoint && <noscript><p class="form-hint">JavaScript is required for the email-preparation form. You can email <a href="mailto:fagacie@gmail.com">fagacie@gmail.com</a> directly.</p></noscript>}
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
