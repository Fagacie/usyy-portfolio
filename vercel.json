{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/resume", "destination": "/assets/Abbas-Usman-Adamu-Resume.pdf" },
    { "source": "/cert/pamerkom", "destination": "/assets/certificates/pamerkom-2026.pdf" },
    { "source": "/cert/deans-sem3", "destination": "/assets/certificates/dean-list-sem3.jpeg" },
    { "source": "/cert/deans-sem4", "destination": "/assets/certificates/dean-list-sem4.jpeg" },
    { "source": "/cert/aspire", "destination": "/assets/certificates/aspire-programme.jpeg" },
    { "source": "/cert/autumn-school", "destination": "/assets/certificates/autumn-school.pdf" },
    { "source": "/cert/ifuture", "destination": "/assets/certificates/ifuture.pdf" },
    { "source": "/cert/media-publicity-officer", "destination": "/assets/certificates/media-publicity-officer.pdf" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
